SELECT IF(
    EXISTS (
        SELECT c.cnum
        FROM customers c
        JOIN orders o ON c.cnum = o.cnum
        GROUP BY c.cnum, c.rating
        HAVING SUM(o.amt) >= ALL (
            SELECT SUM(amt)
            FROM orders
            GROUP BY cnum
        )
        AND c.rating = (
            SELECT MAX(rating)
            FROM customers
        )
    ),
    'yes',
    'no'
) AS answer;

